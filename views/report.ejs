<%- include('partials/header') %>
<section class="container page">
  <div class="page-head"><div><span class="eyebrow">Administrator workspace</span><h1>Attendance report</h1><p>Review workforce attendance and import machine exports.</p></div></div>
  <div class="card">
    <form class="filters" method="get" action="/admin/report">
      <label>Month<input type="month" name="month" value="<%= month.value %>"></label>
      <label>Department<select name="department"><option value="0">All departments</option><% departments.forEach(d => { %><option value="<%= d.id %>" <%= departmentId === d.id ? 'selected' : '' %>><%= d.name %></option><% }) %></select></label>
      <button class="btn btn-primary">Apply filters</button>
    </form>
    <div class="table-wrap"><table><thead><tr><th>Employee</th><th>Department</th><th>Present</th><th>Late</th><th>Absent</th><th>Late rate</th></tr></thead><tbody>
      <% employees.forEach(e => { const lateRate = e.present ? Math.round(e.late * 100 / e.present) : 0; %><tr><td><strong><%= e.first_name %> <%= e.last_name %></strong><small><%= e.employee_id %></small></td><td><%= e.department_name || '—' %></td><td><%= e.present %></td><td><%= e.late %></td><td><%= Math.max(0, workingDays - e.present) %></td><td><%= lateRate %>%</td></tr><% }) %>
    </tbody></table></div>
  </div>
  <div class="card import-card"><div><h2>Import attendance</h2><p class="muted">Upload a CSV with Employee ID, Date, Punch In Time, and optional Punch Out Time columns.</p></div>
    <form action="/admin/import" method="post" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="file" name="attendanceFile" accept=".csv,text/csv" required><button class="btn btn-secondary">Import CSV</button></form>
  </div>
</section>
<%- include('partials/footer') %>

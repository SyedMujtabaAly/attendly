<%- include('partials/header') %><section class="container auth"><div class="card wide"><span class="eyebrow">Join your workspace</span><h1>Create employee account</h1><form action="/register" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><div class="form-grid"><label>Employee ID<input name="employeeId" required autofocus></label><label>Email<input type="email" name="email" required></label><label>First name<input name="firstName" required></label><label>Last name<input name="lastName" required></label><label>Department<select name="departmentId" required><option value="">Select</option><% departments.forEach(d=>{ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></label><label>Shift<select name="shiftId" required><option value="">Select</option><% shifts.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %> (<%= s.start_time.slice(0,5) %>–<%= s.end_time.slice(0,5) %>)</option><% }) %></select></label></div><label>Password<input type="password" name="password" minlength="8" required><small>At least 8 characters</small></label><button class="btn primary full">Create account</button></form><p class="form-note">Already registered? <a href="/login">Sign in</a></p></div></section><%- include('partials/footer') %>
